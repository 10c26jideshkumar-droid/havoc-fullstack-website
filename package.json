{
  "name": "havoc-backend",
  "version": "1.0.0",
  "description": "Production-ready backend API & AI Matching Engine for HAVOC Creator Marketplace",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
